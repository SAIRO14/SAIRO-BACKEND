# 도메인이 아직 없으면 :80으로 둔다. 도메인을 넣으면 Caddy가 HTTPS 인증서를 자동 발급한다.
SERVER_ADDRESS=:80
APP_IMAGE=sairo-backend:local

SPRING_DATASOURCE_URL=jdbc:postgresql://10.10.1.10:5432/sairo
SPRING_DATASOURCE_USERNAME=sairo
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-password

TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=replace-with-tour-api-key
APP_SHARE_BASE_URL=https://sairo.app/shared

# E2.1.Micro(1GB) 기준값. 메모리 측정 전에는 늘리지 않는다.
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
